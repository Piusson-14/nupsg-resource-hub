# Supabase (metadata DB + auth-free reads)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# UploadThing (file bytes). Server-only: never prefix with VITE_.
# Get it from https://uploadthing.com/dashboard -> app -> API Keys.
# Triggers real uploads via /api/uploadthing.js (Vercel serverless).
UPLOADTHING_TOKEN=ut_...
